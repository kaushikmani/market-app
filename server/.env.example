# ── Schwab Trader API (required) ─────────────────────────────────────────────
# Create an app at https://developer.schwab.com (enable the Trader API product),
# then run `node schwab-auth.js` to obtain the access + refresh tokens.
SCHWAB_CLIENT_ID=your_schwab_app_key
SCHWAB_CLIENT_SECRET=your_schwab_app_secret
# OAuth callback registered on your Schwab app (default: https://127.0.0.1)
# SCHWAB_REDIRECT_URI=https://127.0.0.1
# Added automatically by schwab-auth.js — do not fill in by hand:
# SCHWAB_ACCESS_TOKEN=
# SCHWAB_REFRESH_TOKEN=
# SCHWAB_TOKEN_EXPIRES_AT=
# SCHWAB_REFRESH_TOKEN_ISSUED_AT=

# ── AI (local, optional overrides) ───────────────────────────────────────────
# All AI features run through a local Ollama instance — no API key needed.
# Start it with `ollama serve` and `ollama pull gemma4:e4b`.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Browser Profile ──────────────────────────────────────────────────────────
# Optional: custom path for the Playwright browser profile (for X/Twitter login)
# Defaults to ~/.stock-analyzer/browser-profile
# BROWSER_PROFILE_DIR=/custom/path/to/browser-profile
